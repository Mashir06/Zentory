                                android:layout_height="8dp"
                                android:layout_gravity="end|top"
                                android:layout_marginTop="6dp"
                                android:layout_marginEnd="6dp"
                                android:background="@android:drawable/presence_online"
                                android:backgroundTint="#FF3B3B" />
                        </FrameLayout>

                        <TextView
