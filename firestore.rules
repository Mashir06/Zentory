rules_version = '2';

// Reglas de seguridad de Zentory (proyecto zentory-base).
//
// - Cualquier usuario con sesión iniciada puede usar la app como hasta ahora.
// - Solo NubikSoft (cuentas listadas en nubiksoft_admins/{uid}) puede cambiar
//   la suscripción de una tienda, su contacto y su historial de pagos.
// - Las cuentas nuevas quedan pendientes (usuarios/{uid}.aprobado = false)
//   hasta que NubikSoft las aprueba desde el panel web.
// - Las tiendas con estado 'exenta' (uso sin pago, se da desde el panel)
//   funcionan siempre, sin fecha de pago.
// - Si la suscripción de una tienda está suspendida (o venció hace más de 5
//   días), Firebase rechaza agregar, editar o borrar sus productos y lotes.
//   Los datos se pueden seguir leyendo y nunca se borran.
//
// Para aplicarlas: consola de Firebase > Firestore Database > Reglas >
// pegar este archivo > Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isNubikAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/nubiksoft_admins/$(request.auth.uid));
    }

    // Días de gracia después de pagadoHasta (igual que en la app y el panel).
    function graceDays() {
      return duration.value(5, 'd');
    }

    function storeCanEdit(storeId) {
      let store = get(/databases/$(database)/documents/tiendas/$(storeId));
      let sub = store.data.get('suscripcion', null);
      return sub == null || sub.get('estado', 'activa') == 'exenta' || (
        sub.get('estado', 'activa') != 'suspendida' &&
        (sub.get('pagadoHasta', null) == null ||
          request.time < sub.pagadoHasta + graceDays())
      );
    }

    // Campos de la tienda que solo cambia NubikSoft.
    function touchesBilling() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['suscripcion', 'contacto']);
    }

    // Al crear una tienda, la app solo puede darle el período inicial (60 días:
    // un mes gratis más el primer mes, que se paga al terminar).
    function validTrial() {
      let sub = request.resource.data.get('suscripcion', null);
      return sub == null || (
        sub.get('estado', 'activa') == 'activa' &&
        sub.pagadoHasta is timestamp &&
        sub.pagadoHasta <= request.time + duration.value(61, 'd') &&
        !('contacto' in request.resource.data)
      );
    }

    // Lista de administradores de NubikSoft: se crean a mano en la consola.
    match /nubiksoft_admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Campos de la aprobación de cuentas nuevas: solo los cambia NubikSoft.
    function touchesApproval() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['aprobado', 'aprobadoPor', 'fechaAprobacion']);
    }

    // Las cuentas nuevas se crean con aprobado: false y esperan a que
    // NubikSoft las apruebe desde el panel web.
    match /usuarios/{uid} {
      allow read: if signedIn();
      allow create: if isNubikAdmin() ||
        (signedIn() && request.auth.uid == uid &&
          request.resource.data.get('aprobado', null) == false);
      allow update: if isNubikAdmin() || (signedIn() && !touchesApproval());
      allow delete: if isNubikAdmin() || (signedIn() && request.auth.uid == uid);
    }

    match /tiendas/{storeId} {
      allow read: if signedIn();
      allow create: if isNubikAdmin() || (signedIn() && validTrial());
      allow update: if isNubikAdmin() || (signedIn() && !touchesBilling());
      allow delete: if signedIn();

      match /productos/{lotId} {
        allow read: if signedIn();
        allow write: if isNubikAdmin() || (signedIn() && storeCanEdit(storeId));
      }

      match /catalogo/{productId} {
        allow read: if signedIn();
        allow write: if isNubikAdmin() || (signedIn() && storeCanEdit(storeId));
      }

      match /personal/{memberId} {
        allow read, write: if signedIn();
      }

      match /minisupers/{branchId} {
        allow read, write: if signedIn();
      }

      // Historial de pagos: lo registra NubikSoft desde el panel.
      match /pagos/{paymentId} {
        allow read: if signedIn();
        allow write: if isNubikAdmin();
      }
    }

    // Búsqueda de las tiendas de un trabajador (collectionGroup 'personal').
    match /{path=**}/personal/{memberId} {
      allow read: if signedIn();
    }
  }
}
